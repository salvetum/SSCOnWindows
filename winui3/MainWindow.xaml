<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="A2DPWBWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:A2DPWBWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SSC On Windows"
    mc:Ignorable="d">

    <!-- 
      Overall layout:
         Row 0: Header (title + action buttons)
         Row 1: Live status line
         Row 2: Main content (*):
                 - left:   device list (fixed 300px)
                 - right:  scrollable control panels (Expander groups)
         Row 3: Log console (fixed height)
    -->
    <Grid Padding="24" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Header ===================== -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="SSC On Windows" />
                <TextBlock x:Name="VersionCreditText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"
                           Text="v0.1 &#183; by Salvetum" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="ScanButton" Content="Scan Devices" Click="OnScanClick" />
                <Button x:Name="ConnectButton" Content="Connect" IsEnabled="False" Click="OnConnectClick" />
                <Button x:Name="DirectConnectButton" Content="Direct Connect" Click="OnDirectConnectClick" />
                <Button x:Name="ReconnectLastButton" Content="Reconnect Last" IsEnabled="False" Click="OnReconnectLastClick" />
                <Button x:Name="ClearButton" Content="Clear Log" Click="OnClearLogClick" />
                <Button x:Name="SetupButton" Content="Setup &amp; Help" Click="OnSetupClick" />
            </StackPanel>
        </Grid>

        <!-- ===================== Status ===================== -->
        <Border Grid.Row="1" Padding="10,4" CornerRadius="4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="Gray" />
        </Border>

        <!-- ===================== Main content ===================== -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: device list -->
            <Border Grid.Column="0" Padding="12" CornerRadius="8"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Devices" FontWeight="SemiBold" />
                    <ListView x:Name="DeviceListView" Grid.Row="1"
                              SelectionChanged="OnDeviceSelectionChanged" />
                </Grid>
            </Border>

            <!-- Right: scrollable control panels -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,0,4,0">
                <StackPanel Spacing="10">
                    <!-- Direct connect -->
                    <Expander Header="Direct Connect">
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="MAC:" Width="50" VerticalAlignment="Center" />
                                <TextBox x:Name="MacAddressBox" Width="220"
                                         Text="78:C1:1D:A7:BC:EE"
                                         PlaceholderText="XX:XX:XX:XX:XX:XX" />
                            </StackPanel>
                            <TextBlock Text="Enter a known device address, then press 'Direct Connect' (header)."
                                       Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>

                    <!-- Codec -->
                    <Expander Header="Codec" IsExpanded="True">
                        <StackPanel Spacing="10" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Codec:" Width="80" VerticalAlignment="Center" />
                                <ComboBox x:Name="CodecCombo" Width="160"
                                          SelectionChanged="OnCodecChanged">
                                    <ComboBoxItem Content="SSC" IsSelected="True" />
                                    <ComboBoxItem Content="AAC" />
                                    <ComboBoxItem Content="SBC" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Quality:" Width="80" VerticalAlignment="Center" />
                                <ComboBox x:Name="QualityCombo" Width="160"
                                          SelectionChanged="OnQualityChanged">
                                    <ComboBoxItem Content="High" IsSelected="True" />
                                    <ComboBoxItem Content="Standard" />
                                    <ComboBoxItem Content="Mobile" />
                                </ComboBox>
                                <TextBlock Text="Rate:" Width="40" VerticalAlignment="Center" />
                                <ComboBox x:Name="RateCombo" Width="110"
                                          SelectionChanged="OnRateChanged">
                                    <ComboBoxItem Content="48k" IsSelected="True"
                                                  ToolTipService.ToolTip="SSC standard 48 kHz" />
                                    <ComboBoxItem Content="96k"
                                                  ToolTipService.ToolTip="SSC UHQ (96 kHz, requires 2x SRC)" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Bit Depth:" Width="80" VerticalAlignment="Center" />
                                <ComboBox x:Name="BitDepthCombo" Width="160"
                                          SelectionChanged="OnBitDepthChanged"
                                          ToolTipService.ToolTip="PCM bit depth. Sample width is fixed per codec at runtime (SSC: 32-bit, SBC/AAC: 16-bit).">
                                    <ComboBoxItem Content="Auto" IsSelected="True" />
                                    <ComboBoxItem Content="16-bit" />
                                    <ComboBoxItem Content="24-bit" />
                                    <ComboBoxItem Content="32-bit" />
                                </ComboBox>
                                <TextBlock x:Name="BitDepthHintText" Text="" Foreground="Gray"
                                           FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Bitrate:" Width="80" VerticalAlignment="Center" />
                                    <TextBlock x:Name="BitrateValueText" Text="auto"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Text="(0 = auto)" VerticalAlignment="Center"
                                               Foreground="Gray" FontSize="12" />
                                </StackPanel>
                                <Slider x:Name="BitrateSlider" Minimum="0" Maximum="990"
                                        StepFrequency="1" Value="0" Width="340"
                                        HorizontalAlignment="Left"
                                        ValueChanged="OnBitrateChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- Output -->
                    <Expander Header="Output">
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Volume:" Width="80" VerticalAlignment="Center" />
                                    <TextBlock x:Name="VolumeValueText" Text="100%"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100"
                                        StepFrequency="1" Value="100" Width="340"
                                        HorizontalAlignment="Left"
                                        ToolTipService.ToolTip="Device volume (AVRCP absolute volume)"
                                        ValueChanged="OnVolumeChanged" />
                            </StackPanel>
                            <CheckBox x:Name="AutoMuteCheck" Content="Mute speakers while streaming"
                                      Checked="OnAutoMuteChanged" Unchecked="OnAutoMuteChanged" />
                            <CheckBox x:Name="AutoConnectCheck"
                                      Content="Auto-connect last device on start"
                                      Checked="OnAutoConnectChanged" Unchecked="OnAutoConnectChanged" />
                        </StackPanel>
                    </Expander>

                    <!-- Streaming mode / dongle -->
                    <Expander Header="Streaming Mode (Dongle)">
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="DriverStateText" Text="Detecting..."
                                           VerticalAlignment="Center" FontWeight="SemiBold" />
                                <Button x:Name="RefreshDriverButton" Content="Refresh"
                                        Click="OnRefreshDriverClick" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="DriverDetailText" Text="" Foreground="Gray"
                                       FontSize="12" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="EnableStreamingButton"
                                        Content="Enable Streaming (WinUSB)"
                                        Click="OnEnableStreamingClick" />
                                <Button x:Name="RestoreBtButton"
                                        Content="Restore Windows BT (BTHUSB)"
                                        Click="OnRestoreBtClick" />
                            </StackPanel>
                            <TextBlock Text="A UAC prompt runs pnputil; stop streaming before switching."
                                       Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>

                    <!-- Stream info -->
                    <Expander Header="Stream Info">
                        <StackPanel Spacing="6" Margin="0,8,0,0">
                            <TextBlock x:Name="CodecText" Text="Codec: ---" />
                            <TextBlock x:Name="BitrateText" Text="Bitrate: ---" />
                            <TextBlock x:Name="SampleRateText" Text="Sample Rate: ---" />
                            <TextBlock x:Name="ChannelsText" Text="Channels: ---" />
                            <TextBlock x:Name="SourceInfoText" Text="Source: ---" Foreground="Gray" FontSize="12" />
                        </StackPanel>
                    </Expander>

                    <!-- Live stats -->
                    <Expander Header="Live Stats">
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock x:Name="LatencyText" Text="Latency: ---" />
                                <TextBlock x:Name="ErrorRateText" Text="Error Rate: ---" />
                                <TextBlock x:Name="LossRateText" Text="Loss Rate: ---" />
                            </StackPanel>
                            <TextBlock x:Name="QueueText" Text="Queue: ---" Foreground="Gray" FontSize="12" />
                            <Border Height="56" Padding="4"
                                    Background="#15FFFFFF"
                                    BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                    BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Polyline x:Name="SparklineError" Stroke="#FFCC4444" StrokeThickness="1" />
                                    <Polyline x:Name="SparklineLatency"
                                              Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                              StrokeThickness="1.5" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="SparklineCaption" Text="Latency / Error history"
                                       Foreground="Gray" FontSize="11" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===================== Log console ===================== -->
        <Border Grid.Row="3" Height="120" Padding="8,4"
                BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="1" CornerRadius="4"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText" Text="Ready" FontFamily="Consolas" FontSize="11"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
