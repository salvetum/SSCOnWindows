  <!--
    The native (C++/WinRT) XAML build rules normally live in the UWP C++ toolset
    (Microsoft.Windows.UI.Xaml.Cpp.Targets), which is not installed here. The
    interop targets only wire MarkupCompilePass1/2 into the *managed* build via
    $(PrepareResourcesDependsOn). For native builds we must run both passes
    ourselves after MIDL + CppWinRT have merged the project winmd, and before
    ClCompile consumes the generated code.
  -->
  <PropertyGroup>
    <BuildCompileTargets>
      XamlPreCompile;
      $(BuildCompileTargets);
    </BuildCompileTargets>
  </PropertyGroup>
  <Target Name="XamlPreCompile" DependsOnTargets="GetWinUIMetadataReferences;MarkupCompilePass1;MarkupCompilePass2">
    <ItemGroup>
      <ClCompile Remove="@(XamlGFiles)" />
      <ClCompile Remove="@(GeneratedXamlPagesFiles)" />
    </ItemGroup>
    <ItemGroup>
      <ClCompile Include="@(GeneratedXamlPagesFiles)" Condition="'%(Extension)' == '.cpp'" />
      <ClCompile Include="@(XamlGFiles)" Condition="'%(Extension)' == '.cpp'" />
      <ClCompile Include="@(XamlGFiles)" Condition="'%(Extension)' == '.hpp'" />
      <ClCompile Include="@(_GeneratedCodeFiles)" Condition="'%(Extension)' == '.cpp'" />
      <ClCompile Include="$(XamlGeneratedOutputPath)MainWindow.xaml.g.hpp" Condition="Exists('$(XamlGeneratedOutputPath)MainWindow.xaml.g.hpp')" />
    </ItemGroup>
    <Message Text="XamlPreCompile ClCompile: '@(ClCompile)'" Importance="high" />
  </Target>
  <!--
